{
  "name": "foodiehub-root",
  "version": "1.0.0",
  "private": true,
  "description": "FoodieHub - Online Food Ordering System (MERN Stack)",
  "scripts": {
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "install:all": "npm run install:backend && npm run install:frontend",
    "build": "npm run install:all && cd frontend && npm run build",
    "start:prod": "cd backend && node server.js",
    "seed": "cd backend && npm run seed",
    "test": "cd backend && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}